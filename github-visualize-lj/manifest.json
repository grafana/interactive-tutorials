{
  "id": "github-visualize-lj",
  "type": "path",
  "description": "A learning path that shows you how to visualize GitHub repository data in Grafana Cloud.",
  "category": "query-and-visualize",
  "author": {
    "name": "bonnywelsford-source",
    "team": "Grafana Documentation"
  },
  "startingLocation": "/dashboards",
  "targeting": {
    "match": {
      "or": [
        {
          "and": [
            {
              "urlPrefix": "/dashboard/new"
            },
            {
              "tag": "selected-datasource:grafana-github-datasource"
            },
            {
              "targetPlatform": "cloud"
            },
            {
              "userRoleIn": [
                "Editor",
                "Admin"
              ]
            }
          ]
        },
        {
          "and": [
            {
              "urlPrefix": "/d/"
            },
            {
              "allTags": [
                "dashboard:edit",
                "selected-datasource:grafana-github-datasource"
              ]
            },
            {
              "targetPlatform": "cloud"
            },
            {
              "userRoleIn": [
                "Editor",
                "Admin"
              ]
            }
          ]
        }
      ]
    }
  },
  "testEnvironment": {
    "tier": "cloud"
  },
  "milestones": [
    "github-visualize-build-issues-panel",
    "github-visualize-build-pr-panel",
    "github-visualize-build-repository-panel",
    "github-visualize-end-journey"
  ],
  "depends": [
    "github-data-source-lj"
  ],
  "recommends": [],
  "suggests": [],
  "provides": []
}
