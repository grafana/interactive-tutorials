{
  "id": "grafana-table-signal-workbench",
  "type": "guide",
  "description": "Build a table with column filters, summary calculations, and numeric gauges.",
  "category": "dashboards",
  "author": {
    "name": "Jayclifford345",
    "team": "Developer Advocacy"
  },
  "startingLocation": "/dashboards",
  "recommends": [],
  "testEnvironment": {
    "minVersion": "13.3.0"
  },
  "targeting": {
    "match": {
      "or": [
        {
          "and": [
            {
              "urlPrefix": "/dashboard/new"
            },
            {
              "tag": "panel-type:table"
            },
            {
              "userRoleIn": [
                "Editor",
                "Admin"
              ]
            }
          ]
        },
        {
          "and": [
            {
              "urlPrefix": "/d/"
            },
            {
              "allTags": [
                "dashboard:edit",
                "panel-type:table"
              ]
            },
            {
              "userRoleIn": [
                "Editor",
                "Admin"
              ]
            }
          ]
        }
      ]
    }
  }
}
