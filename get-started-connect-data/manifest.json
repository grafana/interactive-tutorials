{
  "id": "get-started-connect-data",
  "type": "guide",
  "description": "Connect a system that already holds your data as a Grafana Cloud data source, test the connection with Save & test, and run a first query in Explore.",
  "category": "onboarding",
  "author": {
    "team": "Grafana Documentation",
    "name": "Chris Moyer"
  },
  "startingLocation": "/connections",
  "targeting": {
    "match": {
      "or": [
        {
          "and": [
            {
              "and": [
                {
                  "urlRegex": "^/connections/?$"
                },
                {
                  "targetPlatform": "cloud"
                }
              ]
            },
            {
              "userRoleIn": [
                "Admin"
              ]
            }
          ]
        },
        {
          "and": [
            {
              "and": [
                {
                  "urlRegex": "^/connections/datasources/?$"
                },
                {
                  "targetPlatform": "cloud"
                }
              ]
            },
            {
              "userRoleIn": [
                "Admin"
              ]
            }
          ]
        },
        {
          "and": [
            {
              "and": [
                {
                  "urlPrefix": "/connections/add-new-connection"
                },
                {
                  "targetPlatform": "cloud"
                }
              ]
            },
            {
              "userRoleIn": [
                "Admin"
              ]
            }
          ]
        }
      ]
    }
  },
  "testEnvironment": {
    "tier": "cloud"
  },
