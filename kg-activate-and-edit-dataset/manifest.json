{
  "id": "kg-activate-and-edit-dataset",
  "type": "guide",
  "description": "Activate the knowledge graph from the Entity catalog, then edit the Kubernetes Monitoring dataset and check the environment and region values.",
  "category": "observability",
  "author": {
    "team": "interactive-learning"
  },
  "startingLocation": "/a/grafana-asserts-app/catalog",
  "targeting": {
    "match": {
      "and": [
        { "source": "learn.grafana.net" },
