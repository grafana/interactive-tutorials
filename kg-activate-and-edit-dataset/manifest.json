            { "urlPrefix": "/a/grafana-asserts-app/get-started" },
            { "urlPrefix": "/a/grafana-asserts-app/configuration" },
            { "urlPrefix": "/observability" }
          ]
        }
      ]
    }
  },
  "testEnvironment": {
    "tier": "cloud",
    "instance": "learn.grafana.net",
    "plugins": ["grafana-asserts-app"]
  },
  "depends": [
    "plugin-enabled:grafana-asserts-app"
  ]
}
