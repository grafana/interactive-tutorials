                "on-page:/dashboard/new",
                "min-version:13.3.0"
              ],
              "description": "Add a panel",
              "tooltip": "Add a panel."
            },
            {
              "id": "step-37",
              "action": "highlight",
              "reftarget": "{grafana:components.Sidebar.configurePanelButton}",
              "requirements": [
