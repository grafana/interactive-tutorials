        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "SELECT COALESCE(OnCallScheduleLookUp.schedule_name, TeamLookUp.name || ' (no schedule configured)') as schedule, COALESCE(UserLookUp.username, 'No one scheduled') as oncall_user FROM TeamLookUp LEFT JOIN OnCallScheduleLookUp ON OnCallScheduleLookUp.team_id = TeamLookUp.id LEFT JOIN UserLookUp ON OnCallScheduleLookUp.user_id = UserLookUp.user_id WHERE TeamLookUp.name = 'Retail Banking' ORDER BY schedule",
          "refId": "A",
          "type": "sql"
        }
      ],
      "title": "Who is on call (Retail Banking)",
      "transformations": [
        {
          "id": "filterByRefId",
          "options": {
            "include": "/^(?:A)$/"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "oncall_user": "On-call now",
              "schedule": "Schedule"
            }
          }
        }
      ],
      "type": "table"
