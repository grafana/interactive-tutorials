      "id": 1,
      "options": {
        "content": "# Account Service (Go)\nManages customer accounts and balances: business metrics track account requests by operation and result, balance reads, and how many accounts are returned per listing.",
        "mode": "markdown"
      },
      "title": "",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum by(operation, result) (rate(app_banking_account_requests_total{service_name=\"account\", service_namespace=\"${namespace}\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} ({{result}})",
          "refId": "A"
        }
      ],
      "title": "Account Requests by Operation",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 3
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by(result) (rate(app_banking_account_balance_reads_total{service_name=\"account\", service_namespace=\"${namespace}\"}[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "title": "Balance Reads",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 3
      },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le) (rate(app_banking_accounts_returned_bucket{service_name=\"account\", service_namespace=\"${namespace}\"}[$__rate_interval])))",
          "legendFormat": "P95 accounts returned",
          "refId": "A"
        }
      ],
      "title": "Accounts Returned per Listing (P95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum by(service_name) (rate(rpc_server_call_duration_seconds_count{service_name=\"account\", service_namespace=\"${namespace}\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisSoftMax": 0.2,
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "max": 1,
          "min": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 11
      },
      "id": 6,
      "targets": [
        {
          "expr": "(clamp_max(sum by(service_name) (rate(rpc_server_call_duration_seconds_count{service_name=\"account\", service_namespace=\"${namespace}\", rpc_response_status_code!=\"OK\"}[$__rate_interval])) / clamp_min(sum by(service_name) (rate(rpc_server_call_duration_seconds_count{service_name=\"account\", service_namespace=\"${namespace}\"}[$__rate_interval])), 0.001), 1)) OR on(service_name) (0 * sum by(service_name) (max_over_time(rpc_server_call_duration_seconds_count{service_name=\"account\", service_namespace=\"${namespace}\"}[30d])))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "title": "Error Ratio",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
