          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by(le) (rate(rpc_server_call_duration_seconds_bucket{service_name=\"account\", service_namespace=\"${namespace}\"}[$__rate_interval])))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "title": "Latency P50 / P95 / P99",
      "type": "timeseries"
