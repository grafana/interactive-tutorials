      },
      "id": 7,
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by(le) (rate(rpc_server_call_duration_seconds_bucket{service_name=\"account\", service_namespace=\"${namespace}\"}[$__rate_interval])))",
