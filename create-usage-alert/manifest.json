{
  "schemaVersion": "1.1.0",
  "id": "create-usage-alert",
  "type": "guide",
  "description": "Hands-on guide: Create a budget alert on your Grafana Cloud spend in the Cost Management and Billing app.",
  "category": "cost-and-usage",
  "author": {
    "name": "Eve Meelan",
    "team": "Documentation"
  },
  "startingLocation": "/a/grafana-cmab-app/usage-alerts",
  "targeting": {
    "match": {
      "or": [
        {
          "and": [
            {
              "urlPrefix": "/a/grafana-cmab-app/usage-alerts"
            },
            {
              "targetPlatform": "cloud"
            }
          ]
        },
        {
          "and": [
            {
              "urlRegex": "^(?:/a/grafana\\-cmab\\-app|/a/grafana\\-cmab\\-app/usage)/?$"
            },
            {
              "targetPlatform": "cloud"
            }
          ]
        }
      ]
    }
  },
  "testEnvironment": {
    "tier": "cloud"
  }
}
