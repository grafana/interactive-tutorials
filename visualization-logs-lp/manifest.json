{
  "id": "visualization-logs",
  "type": "path",
  "description": "Step-by-step guide: Visualize logs in a Grafana Cloud dashboard.",
  "category": "query-and-visualize",
  "author": {
    "name": "jstickler",
    "team": "Documentation"
  },
  "startingLocation": "/dashboards",
  "targeting": {
    "match": {
      "or": [
        {
          "and": [
            {
              "urlPrefix": "/dashboard/new"
            },
            {
              "tag": "selected-datasource:loki"
            },
            {
              "targetPlatform": "cloud"
            },
            {
              "userRoleIn": [
                "Editor",
                "Admin"
              ]
            }
          ]
        },
        {
          "and": [
            {
              "urlPrefix": "/d/"
            },
            {
              "allTags": [
                "dashboard:edit",
                "selected-datasource:loki"
              ]
            },
            {
              "targetPlatform": "cloud"
            },
            {
              "userRoleIn": [
                "Editor",
                "Admin"
              ]
            }
          ]
        }
      ]
    }
  },
  "testEnvironment": {
    "tier": "cloud"
  },
  "milestones": [
    "visualization-logs-add-visualization",
    "visualization-logs-write-query",
    "visualization-logs-time-range-refresh",
    "visualization-logs-save-dashboard",
    "visualization-logs-end-journey"
  ],
  "depends": [
    "drilldown-logs-lj"
  ],
  "suggests": [
    "infrastructure-alerting-lj"
  ],
  "provides": []
}
