{
  "path": "github-visualize-lj",
  "id": "github-visualize-lj",
  "type": "path",
  "milestoneCount": 4,
  "startingLocation": "/dashboards",
  "testEnvironment": {
    "tier": "cloud"
  },
  "targeting": {
    "match": {
      "or": [
        {
          "and": [
            {
              "urlPrefix": "/dashboard/new"
            },
            {
              "tag": "selected-datasource:grafana-github-datasource"
            },
            {
              "targetPlatform": "cloud"
            },
            {
              "userRoleIn": [
                "Editor",
                "Admin"
              ]
            }
          ]
        },
        {
          "and": [
            {
              "urlPrefix": "/d/"
            },
            {
              "allTags": [
                "dashboard:edit",
                "selected-datasource:grafana-github-datasource"
              ]
            },
            {
              "targetPlatform": "cloud"
            },
            {
              "userRoleIn": [
                "Editor",
                "Admin"
              ]
            }
          ]
        }
      ]
    }
  },
  "manifestPrerequisites": null,
  "pathBeforeYouBegin": [
    "Welcome to the GitHub data source learning path that shows you how to visualize GitHub repository data in Grafana Cloud.\n\n## Here's what to expect\n\nWhen you complete this journey, you'll be able to:\n\n- Understand the value of monitoring GitHub repositories with Grafana Cloud\n- Add a GitHub issues panel to a dashboard\n- Add a pull request panel to a dashboard\n- Add a repository list panel to a dashboard\n\n## Before you begin\n\nBefore you start, ensure that you have:\n\n- Already completed the [Connect to a GitHub data source in Grafana Cloud](https://grafana.com/docs/learning-paths/github-data-source/) learning path.\n- Basic familiarity with Grafana navigation and dashboard creation."
  ],
