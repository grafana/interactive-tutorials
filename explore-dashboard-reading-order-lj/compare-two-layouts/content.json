            "on-page:/d/000000110",
            "exists-reftarget"
          ],
          "doIt": false,
          "lazyRender": true,
          "content": "Focus on the **Customer Reviews** bar gauge."
        },
        {
          "type": "interactive",
          "action": "highlight",
          "reftarget": "[data-viz-panel-key='panel-20']",
          "requirements": [
            "on-page:/d/000000110",
            "exists-reftarget"
