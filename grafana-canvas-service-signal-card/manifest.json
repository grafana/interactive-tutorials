{
  "id": "grafana-canvas-service-signal-card",
  "type": "guide",
  "description": "Build a field-bound Canvas service card, then create a connected systems map with a single Run block.",
  "category": "dashboards",
  "author": {
    "name": "Jayclifford345",
    "team": "interactive-learning"
  },
  "startingLocation": "/dashboards",
  "recommends": [],
  "testEnvironment": {
    "minVersion": "13.3.0"
  },
  "targeting": {
    "match": {
      "or": [
        {
          "and": [
            {
              "urlPrefix": "/dashboard/new"
            },
            {
              "tag": "panel-type:canvas"
            },
            {
              "userRoleIn": [
                "Editor",
                "Admin"
              ]
            }
          ]
        },
        {
          "and": [
            {
              "urlPrefix": "/d/"
            },
            {
              "allTags": [
                "dashboard:edit",
                "panel-type:canvas"
              ]
            },
            {
              "userRoleIn": [
                "Editor",
                "Admin"
              ]
            }
          ]
        }
      ]
    }
  }
}
