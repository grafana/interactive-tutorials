{
  "id": "explore-recording-rules-find-rules",
  "title": "Find recording rules",
  "blocks": [
    {
      "type": "section",
      "id": "find-rules",
      "title": "Find recording rules",
      "blocks": [
        {
          "type": "interactive",
          "action": "navigate",
          "reftarget": "/alerting/list",
          "content": "Open the **Alert rules** page."
        },
        {
          "type": "markdown",
          "content": "Recording rules and alert rules are listed on the same page, at **Alerts & IRM** > **Alerting** > **Alert rules**."
        },
        {
          "type": "interactive",
          "action": "highlight",
          "reftarget": "[aria-labelledby='filter-label-rule-type']",
          "requirements": [
            "on-page:/alerting/list",
            "exists-reftarget"
          ],
          "doIt": false,
          "content": "Find the **Type** filter. Its options are **All**, **Alert rule**, and **Recording rule**."
        },
        {
          "type": "interactive",
          "action": "highlight",
          "reftarget": "[aria-labelledby='filter-label-rule-type'] button:contains('Recording rule')",
          "requirements": [
            "on-page:/alerting/list",
            "exists-reftarget"
          ],
          "content": "Select **Recording rule**. The list now shows only recording rules."
        },
        {
          "type": "interactive",
          "action": "highlight",
          "reftarget": "[data-testid='data-testid alerting search-input']",
          "requirements": [
            "on-page:/alerting/list",
            "exists-reftarget"
          ],
          "doIt": false,
          "content": "Notice the search box. It now holds `type:recording`, the filter you selected."
        },
        {
          "type": "markdown",
          "content": "Each recording rule in the list computes the result of a query ahead of time, on a schedule, and saves it as a recorded metric."
        }
      ]
    }
  ]
}
