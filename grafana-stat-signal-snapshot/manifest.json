{
  "id": "grafana-stat-signal-snapshot",
  "type": "guide",
  "description": "Signal snapshot: advanced stat techniques.",
  "category": "dashboards",
  "author": {
    "name": "Grafana Labs",
    "team": "Pathfinder"
  },
  "startingLocation": "/dashboards",
  "recommends": [],
  "testEnvironment": {
    "minVersion": "13.3.0"
  },
  "targeting": {
    "match": {
      "or": [
        {
          "and": [
            {
              "urlPrefix": "/dashboard/new"
            },
            {
              "tag": "panel-type:stat"
            },
            {
              "userRoleIn": [
                "Editor",
                "Admin"
              ]
            }
          ]
        },
        {
          "and": [
            {
              "urlPrefix": "/d/"
            },
            {
              "allTags": [
                "dashboard:edit",
                "panel-type:stat"
              ]
            },
            {
              "userRoleIn": [
                "Editor",
                "Admin"
              ]
            }
          ]
        }
      ]
    }
  }
}
