{
  "rules": [
    {
      "title": "Synthetic Monitoring",
      "url": "https://interactive-learning.grafana.net/packages/get-started-first-check/content.json",
      "description": "Check availability and response time from locations around the world.",
      "type": "interactive",
      "page": "/a/grafana-synthetic-monitoring-app/home",
      "id": "synthetic"
    },
    {
      "title": "Frontend Observability",
      "url": "https://interactive-learning.grafana.net/packages/welcome-frontend-observability/content.json",
      "description": "Explore real user sessions, performance, and errors with the Faro Web SDK.",
      "type": "interactive",
      "page": "/a/grafana-kowalski-app",
      "id": "frontend"
    }
  ],
  "page": {
    "version": 1,
    "width": "standard",
    "spacing": "normal",
    "header": "minimal",
    "blocks": [
      {
        "type": "hero",
        "title": "Digital Experience Monitoring",
        "description": "Understand your website from the outside in with Synthetic Monitoring and the inside out with Frontend Observability.",
        "alignment": "center",
        "eyebrow": "Grafana Cloud"
      },
      {
        "type": "text",
        "content": "Set up Synthetic Monitoring",
        "alignment": "center",
        "secondary": true
      },
      {
        "type": "command",
        "command": "npx @grafana/cloud-setup synthetics --url https://yourcompany.com --stack your-stack"
      },
      {
        "type": "text",
        "content": "Replace the website URL and stack slug with your own.",
        "alignment": "center",
        "secondary": true
      },
      {
        "type": "text",
        "content": "Set up Frontend Observability",
        "alignment": "center",
        "secondary": true
      },
      {
        "type": "command",
        "command": "npx @grafana/cloud-setup frontend --stack your-stack"
      },
      {
        "type": "text",
        "content": "Run from your frontend project directory. Requires Node.js 22.6 or later and a Grafana Cloud stack. This CLI is a development preview.",
        "alignment": "center",
        "secondary": true
      },
      {
        "type": "divider",
        "label": "Prefer a guided setup in Grafana?"
      },
      {
        "type": "guide-links",
        "layout": "cards",
        "links": [
          {
            "ruleId": "synthetic"
          },
          {
            "ruleId": "frontend"
          }
        ]
      },
      {
        "type": "text",
        "content": "Start with either product and add the other whenever you are ready.",
        "alignment": "center",
        "secondary": true
      }
    ]
  }
}
