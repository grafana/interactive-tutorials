    {
      "type": "section",
      "id": "guide-section-20354",
      "title": "Creating your first check",
      "blocks": [
        {
          "type": "interactive",
          "action": "highlight",
          "reftarget": "{grafana:components.NavMenu.Menu} a[data-testid='data-testid Nav menu item'][href='/a/grafana-kowalski-app']",
          "content": "Return Back to Frontend with dashboard",
          "requirements": [
            "exists-reftarget",
            "navmenu-open"
          ]
        },
        {
          "type": "interactive",
          "action": "highlight",
          "reftarget": "div[data-testid='data-testid App plugin page grafana-kowalski-app'] a[data-testid='btn-create-app']",
          "content": "Create New Dashboard",
          "requirements": [
            "exists-reftarget"
          ]
        },
        {
          "type": "interactive",
          "action": "formfill",
          "reftarget": "div[data-testid='input-wrapper'] input[data-testid='app-name']",
          "targetvalue": "QuickPizza:App",
          "content": "Name of new dashboard"
        },
        {
          "type": "interactive",
          "action": "formfill",
          "reftarget": "div[data-testid='input-wrapper'] input[data-testid='cors-0']",
          "targetvalue": "http://localhost:3333",
          "content": "Website",
          "requirements": [
            "exists-reftarget"
          ]
        },
        {
          "type": "interactive",
          "action": "highlight",
          "reftarget": "form[data-testid='web-app-form'] button[data-testid='new-app-submit']",
          "content": "Move to next section",
          "requirements": [
            "exists-reftarget"
          ]
        },
        {
          "type": "interactive",
          "action": "highlight",
          "reftarget": "Manual instrumentation",
          "content": "You have 4 options, choose manual instrumentation\nTODO: No Selector",
          "requirements": [
            "exists-reftarget"
          ],
          "skippable": true
        },
        {
          "type": "interactive",
          "action": "highlight",
          "reftarget": "div:nth-match(1)",
          "content": "Choose package",
          "requirements": [
            "exists-reftarget"
          ]
        },
        {
          "type": "interactive",
          "action": "highlight",
          "reftarget": "div[data-testid='data-testid App plugin page grafana-kowalski-app'] div",
          "content": "Add Faro to Application",
          "requirements": [
            "exists-reftarget"
          ]
        },
        {
          "type": "interactive",
          "action": "button",
          "reftarget": "Continue",
          "content": "TODO - selector test button",
          "requirements": [
            "exists-reftarget"
          ]
        },
        {
          "type": "interactive",
          "action": "highlight",
          "reftarget": "Continue",
          "content": "Source Map\nTODO: continue",
          "requirements": [
            "exists-reftarget"
          ]
        },
        {
          "type": "interactive",
          "action": "button",
          "reftarget": "div[data-testid='data-testid App plugin page grafana-kowalski-app'] a",
          "content": "Complete"
        }
      ]
    },
    {
      "type": "interactive",
      "action": "highlight",
      "reftarget": "div[data-testid='data-testid App plugin page grafana-kowalski-app'] div",
      "content": "Applications Should Show Data",
      "requirements": [
        "exists-reftarget"
      ]
    },
